{
    "cli_default_open_behavior": "existing_window",
    "disable_ai": true,
    "outline_panel": {
        "dock": "left"
    },
    "project_panel": {
        "dock": "left"
    },
    "autosave": "off",
    "relative_line_numbers": "enabled",
    "ui_font_size": 15,
    "buffer_font_size": 14,
    "buffer_line_height": {
        "custom": 1.6
    },
    "theme": "Noctalia Dark Transparent",
    "cursor_blink": false,
    "scrollbar": {
        "show": "auto"
    },
    "vertical_scroll_margin": 8,
    "tab_size": 4,
    "hard_tabs": false,
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "show_whitespaces": "selection",
    "format_on_save": "on",
    "formatter": "language_server",
    "soft_wrap": "none",
    "wrap_guides": [100],
    "show_wrap_guides": true,
    "inlay_hints": {
        "enabled": false
    },
    "git": {
        "inline_blame": {
            "enabled": false
        }
    },
    "languages": {
        "Markdown": {
            "remove_trailing_whitespace_on_save": false,
            "soft_wrap": "editor_width"
        }
    },
    "terminal": {
        "font_size": 13,
        "line_height": {
            "custom": 1.5
        },
        "shell": {
            "program": "bash"
        },
        "working_directory": "current_project_directory"
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    }
}
